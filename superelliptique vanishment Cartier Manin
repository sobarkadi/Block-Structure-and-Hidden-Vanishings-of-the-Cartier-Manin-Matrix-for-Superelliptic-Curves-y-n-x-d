\subsection*{A complete by-hand proof: the mixed case $(n,p,d,r,k_0)=(12,23,13,10,5)$}

Here $k_1=5\cdot23^{-1}\equiv7\pmod{12}$, $g_0=\lfloor65/12\rfloor=5$,
$g_1=\lfloor91/12\rfloor=7$, $N_0=(7\cdot23-5)/12=13$,
$N_1=(5\cdot23-7)/12=9$, $f=1+\sigma x^{10}+x^{13}$ over $\F_{23}$. The entries are
$\sum\frac{N!}{u!v!w!}\sigma^v$ over $u+v+w=N$, $10v+13w=e$, with $e=23b-i$ for
$M_0$ ($N=13$) and $e=23a-b$ for $M_1$ ($N=9$).

\emph{Step 1: rows $b=1,2,3$ of $M_0$ are supported on columns $\{3,4\}$.} Row
$b=1$: exponents $18,\dots,22$, of which only $20=10\cdot2$ has the form
$10v+13w$ ($v+w\le13$); entry $\frac{13!}{11!\,2!}\sigma^2=78\sigma^2$ in column
$3$. Row $2$: exponents $41,\dots,45$, only $43=3\cdot10+13$ fits:
$\frac{13!}{9!\,3!\,1!}\sigma^3=2860\sigma^3$ in column $3$. Row $3$: exponents
$64,\dots,68$; only $66=4\cdot10+2\cdot13$ (column $3$, $25740\sigma^4$) and
$65=5\cdot13$ (column $4$, $1287$) fit. Hence
$\operatorname{rk}M_0[\{1,2,3\},:]\le2$.

\emph{Step 2: $\operatorname{rk}M_1[:,\{4,5,6,7\}]\le2$ modulo $23$.} Column $5$
of $M_1$ is zero (exponents $18,41,64,87,110$: none of the form $10v+13w$ with
$v+w\le9$). Columns $4,6,7$ have as non-zero entries (rows $a=1,\dots,5$):
$$c_4=(0,0,126,252\sigma,36\sigma^2),\quad c_6=(0,126\sigma^4,504\sigma^5,252\sigma^6,0),\quad c_7=(0,84,630\sigma,756\sigma^2,84\sigma^3),$$
for example $126=\frac{9!}{4!\,5!}$ (exponent $65=5\cdot13$),
$252=\frac{9!}{2!\,1!\,6!}$ (exponent $88=10+6\cdot13$),
$36=\frac{9!}{0!\,2!\,7!}$ ($111=20+7\cdot13$), etc. One checks, row by row,
$$13\sigma^5\,c_4+7\,c_6+\sigma^4\,c_7\equiv0\pmod{23},$$
since the integer sums are: row $2$: $7\cdot126+84=966=23\cdot42$; row $3$:
$13\cdot126+7\cdot504+630=5796=23\cdot252$; row $4$:
$13\cdot252+7\cdot252+756=5796=23\cdot252$; row $5$: $13\cdot36+84=552=23\cdot24$;
row $1$: all entries are zero. Hence $\operatorname{rk}M_1[:,\{4,5,6,7\}]\le2$.

\emph{Step 3: conclusion.} With $S=\{4,5,6,7\}$ and $S^c=\{1,2,3\}$,
Prop.~\ref{prop:cut} gives $\operatorname{rk}\Phi\le2+2=4<5=g_0$, hence
$\det\Phi\equiv0\pmod{23}$ for every $\sigma\in\F_{23}$. (The two bounds are
those of single factors, so by the diagonal version of Prop.~\ref{prop:cut} the
same conclusion holds for every product $M_1DM_0$ with $D$ invertible diagonal;
see \S\ref{sec:tvar}.)

\emph{The support of $\Phi$ nevertheless admits a perfect matching} (so this is
not a Menger case): for $\sigma\neq0$, the following paths $a\to b\to i$ use only
entries that are non-zero modulo $23$ and are disjoint: $1\to3\to4$, $5\to1\to3$,
$2\to7\to5$, $3\to6\to1$, $4\to4\to2$ (entries $M_1[1,3]=13\sigma^2$,
$M_0[3,4]=22$; $M_1[5,1]=9\sigma$, $M_0[1,3]=9\sigma^2$; $M_1[2,7]=15$,
$M_0[7,5]=13$; $M_1[3,6]=21\sigma^5$, $M_0[6,1]=12\sigma^2$;
$M_1[4,4]=22\sigma$, $M_0[4,2]=2\sigma^9$). This is a hidden vanishing, with
$\operatorname{rk}\Phi=4$ checked numerically.

\section{The variant $y^n=x^d+\sigma x^r+t$ and parameters outside $\F_p$}
\label{sec:tvar}

Let $t\in\F_p^\times$ and $f_t=t+\sigma x^r+x^d$. The blocks $M_0(\sigma,t)$,
$M_1(\sigma,t)$ are defined by the same formulas, with $t^u\sigma^v$ in place of
$\sigma^v$ in the multinomial sum, and $\Phi(\sigma,t)=M_1M_0$ is the honest
Cartier product of the $\F_p$-curve $y^n=f_t$ (no twist is needed, since all
coefficients lie in $\F_p$).

\begin{proposition}[\textbf{[D]}, scaling]
\label{prop:scal}
Let $\lambda\in\overline{\F}_p$ with $\lambda^d=t$ and $\sigma'=\sigma\lambda^{r-d}$.
Then $M_j(\sigma,t)[b,i]=t^{N_j}\lambda^{-pb}\cdot\lambda^{i}\,M_j(\sigma',1)[b,i]$
(for $j=0$; for $j=1$ replace $b,i$ by $a,b$): each block is a row scaling times a
column scaling of the block at $(\sigma',1)$. Consequently
$\Phi(\sigma,t)=D_1\,M_1(\sigma',1)\,D\,M_0(\sigma',1)\,D_2$ with $D_1,D_2$ invertible
diagonal and $D=\operatorname{diag}(\lambda^{(1-p)b})_b$. In particular, if
$\lambda\in\F_p$ (e.g.\ if $t$ is a $d$-th power in $\F_p^\times$), then $D=1$ and
$\operatorname{rk}\Phi(\sigma,t)=\operatorname{rk}\Phi(\sigma',1)$ with
$\sigma'\in\F_p$.
\end{proposition}
\begin{proof}
$f_t(\lambda x)=t+\sigma\lambda^rx^r+tx^d=t\,f_{\sigma'}(x)$, hence
$[x^e]f_t^N=\lambda^{-e}t^N[x^e]f_{\sigma'}^N$; put $e=pb-i$. The product is
formed with $\lambda^{b}$ (from $M_1$) times $\lambda^{-pb}$ (from $M_0$), which
gives the inner factor $\lambda^{(1-p)b}$.
\end{proof}
For $\lambda\notin\F_p$ (i.e.\ $t$ not a $d$-th power in $\F_p$), $\sigma'$ in
general lies outside $\F_p$ and $M_1D M_0$ is the $\F_p$-rational model of the
Frobenius-twisted product at $\sigma'$ (we do not re-derive here the exact
convention of the twist). So the honest $\F_p$-computation of $\Phi(\sigma,t)$
for $t$ not a $d$-th power gives the rank at a parameter $\sigma'\notin\F_p$,
without having to implement $\F_q$ arithmetic.

\begin{corollary}[\textbf{[D]}, persistence of factor-wise obstructions]
\label{cor:persist}
If the deficiency $\operatorname{rk}\Phi<g_0$ is proved by (i) a Menger obstruction
($\Delta<g_0$), or (ii) a rank deficiency of $M_0$ or of $M_1$ proved by a column relation valid for $\sigma$ in any extension (such as Cor.~\ref{cor:jum}), or (iii) a cut (Prop.~\ref{prop:cut}) whose two bounds
are bounds on the ranks of the single factors, then the same deficiency holds for
$M_1DM_0$ for every invertible diagonal $D$, and hence for $\Phi(\sigma,t)$, for
all $(\sigma,t)$ and also at parameters $\sigma'$ outside $\F_p$. (For (ii) and (iii) the relations among columns hold for $\sigma$ in any extension; for Cor.~\ref{cor:jum} this is because Lemma~\ref{lem:rec} does not use $\sigma\in\F_p$.)
\end{corollary}
This applies to the twin-column, twin-row and mixed-cut classes of the census;
it does not apply to cancellations between non-zero terms, whose mechanism is a
numerical coincidence between several products $A_SB_S$ and may not survive a
change of the inner diagonal. \textbf{Warning (correction).} It is \emph{not}
true that $\det\Phi(\sigma,1)\equiv0$ in $\mathbb Z[\sigma]$ implies
$\det\Phi(\sigma,t)\equiv0$ in $\mathbb Z[\sigma,t]$ by a weight argument: the
total $t$-exponent of a term of $A_SB_S$ is affine in the $\sigma$-degree $V$ but
with an offset that depends on $S$ (through $\Sigma S$, Prop.~\ref{prop:deg}), so
setting $t=1$ can merge terms of different $S$ that stay separate for $t\ne1$.

\paragraph{Sweep \textbf{[V]}.} Script \texttt{tvariant.py} (in the package). Domain:
$p\le31$, $3\le n\le12$, $p^2\equiv1\pmod n$, $p\not\equiv1\pmod n$,
$3\le d\le25$, $\gcd(d,n)=1$, $\gcd(d,p-1)>1$, all $r$, $2\le g_0\le12$,
$k_1>k_0$. We keep the cases (not deduplicated by $k_0/n$) where, at $t=1$, the
rank of $\Phi$ is $<g_0$ for every smooth $\sigma\in\F_p^\times$ and the union of
the supports has a perfect matching: $59$ cases. For each we compute
$\operatorname{rk}\Phi(\sigma,t)$ for all smooth $(\sigma,t)\in(\F_p^\times)^2$
and split by $t$ a $d$-th power (then $\sigma'\in\F_p$) or not.
\begin{center}
\begin{tabular}{lccc}
 & cases & $t$ a $d$-th power: deficient for all & $t$ not a $d$-th power: deficient for all\\\hline
$\det\Phi\equiv0$ over $\mathbb Z$ & 32 & 32 & 32\\
vanishing only modulo $p$ & 27 & 27 & 13 (14 lose the deficiency at some $(\sigma,t)$)\\
\end{tabular}
\end{center}
(Exactness over $\mathbb Z$ is tested at a random $\sigma$ modulo $2^{61}-1$.) So:
(1) for all $32$ cases with an identically vanishing determinant over $\mathbb Z$,
