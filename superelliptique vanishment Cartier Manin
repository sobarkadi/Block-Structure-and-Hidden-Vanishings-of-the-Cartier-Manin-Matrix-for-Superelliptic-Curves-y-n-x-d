\section{Generic support: Conjecture G \textbf{[V]/[O]}}
\label{sec:conjG}

Let $E\subset\{0,\dots,d\}$ with $0,d\in E$ and $f_c=\sum_{e\in E}c_ex^e$ with
indeterminate coefficients $c_e$. Since $N(k)<p$, the multinomials do not vanish
modulo $p$: the support of $M^{(k)}$ is determined by the sums of $N(k)$ terms of
$E$ (in the sense of sumsets), and the flow $\Delta(E)$ of \S\ref{sec:menger}
follows.

\begin{proposition}[\textbf{[D]}]
If $\Delta(E)<g_0$ then $\det\Phi_c\equiv0$ in $\F_p[c]$.
\end{proposition}
(Same proof as Theorem~\ref{thm:menger}: only the support matters.)

\begin{center}\emph{Conjecture G \textbf{[O]}.} For $|E|\ge4$: $\det\Phi_c\not\equiv0$
if and only if $\Delta(E)=g_0$.\end{center}

\emph{Evidence.} The direction ``$\Rightarrow$'' is the proposition. For
``$\Leftarrow$'': $\approx1230$ trials with random coefficients on supports $E$ of
size $\ge4$ (including $474$ ``adversarial'' supports: arithmetic progressions,
$\gcd>1$), no counterexample. For $|E|=3$ the converse is \emph{false}: all the
``zero minor'' and ``cancellation'' cases above are trinomials with
$\Delta=g_0$ and $\det\Phi\equiv0$. An attempted proof by grading
(Proposition~\ref{prop:deg}) and tropical weights (Monge arrays) runs into the
fact that rectangles contained in one segment of the hull give the same total
monomial; binomial minors can then vanish modulo $p$, exactly as in
mechanism~2. \textbf{The conjecture is not proved.}

\paragraph{Adding a fourth monomial \textbf{[V]}.} Replacing $f$ by $f+\tau x^s$
($\tau$ generic) lifts the Menger obstruction for $34$ of the $37$ Menger cases
of the family $p\equiv-1\pmod n$, for every $s$; the three exceptions occur when
$s$ is a small multiple of $r$ modulo $d$. The rank is then full in $57$ cases
out of $60$ draws; the $3$ draws that fall short are not explained.

\section{Remarks: $y^2$ and the link with the complex route}
\label{sec:remarks}

\paragraph{The case $n=2$.} The Menger graph reduces to a Hall condition on the
support of $\Phi$, which is the very definition of hidden vanishing:
Theorem~\ref{thm:menger} is then empty. An earlier sweep ($p\le59$, $d$ odd
$\le29$) found $8$ hidden cases for $y^2$, none with $d=p$; they come under the
monomial gauge known for $y^2$ (\textbf{[V]}).

\paragraph{Hypergeometric dictionary \textbf{[O]}.} The periods
$\int x^i\,dx/y^k$ of the family are expressed by hypergeometric series in
$z=\sigma^m$, $m=d/\gcd(d,r)$, which split according to the class of
$v\bmod m$; the Hasse--Witt matrix is a truncation of such series
($A$-hypergeometric series, Adolphson--Sperber, arXiv:1601.05127). Their
Theorem~2.3 (generic invertibility of the Hasse--Witt determinant under a support
condition, by a convex-hull argument) has the same form as Conjecture~G. We have
read only excerpts: it is not used in our proofs, and we do not know whether it
implies Conjecture~G.

\section{Version 4.1: second iterate, kernel of a block, exact forms and rank cuts}
\label{sec:v41}

This section adds proved results (\textbf{[D]}), numerical checks (\textbf{[V]})
and open points (\textbf{[O]}). It also corrects a point of scope: unless stated
otherwise, the statements ``for every $\sigma$'' concern $\sigma\in\F_p$ (see
Lemma~\ref{lem:iter}). The arguments about exact forms are standard (the kernel
of the Cartier operator is the space of exact forms); we claim no novelty on
these points.

\subsection*{The second iterate}

On $\F_p[x]\,dx$ the Cartier operator is
$C\big(\sum c_m x^m dx\big)=\sum_j c_{pj-1}\,x^{j-1}dx$. It is $\F_p$-linear and
satisfies $C(g^p\omega)=g\,C(\omega)$ and $C(dg)=0$. With the notation of Th.~A,
$M_0[b,i]=[x^{pb-i}]f^{N_0}$ is the matrix of $h\mapsto C(f^{N_0}h\,dx)$ on
polynomials $h=\sum_i h_ix^{i-1}$ of degree $<g_0$ towards those of degree
$<g_1$; likewise for $M_1$ and $N_1$.

\begin{lemma}[\textbf{[D]}, second iterate]
\label{lem:iter}
Let $\sigma\in\F_p$, $f=1+\sigma x^r+x^d$ and $M=pN_1+N_0$. Then $\Phi=M_1M_0$ is
the matrix of $h\mapsto C^2(f^{M}h\,dx)$, i.e.\ $\Phi[a,i]=[x^{p^2a-i}]f^{M}$.
\end{lemma}
\begin{proof}
$C(f^{N_1}\,C(f^{N_0}h\,dx))=C\big(C(f^{pN_1}f^{N_0}h\,dx)\big)$ because
$f^{N_1}C(\omega)=C\big((f^{N_1})^p\omega\big)$ (property $C(g^p\omega)=gC(\omega)$
with $g=f^{N_1}$, with coefficients in $\F_p$). Then one reads the coefficient of
$x^{p^2a-1}$ in $f^{M}x^{i-1}$.
\end{proof}

\begin{remark}[\textbf{Frobenius twist}]
For $\sigma\in\F_q\setminus\F_p$ the Cartier operator is semilinear
($C(c\omega)=c^{1/p}C(\omega)$) and the correct product involves a factor twisted
by Frobenius (this is the twisted product of Achter--Howe). The statements
``$\det\Phi\equiv0$ for every $\sigma$'' of this document are therefore to be
read for $\sigma\in\F_p$. Menger's theorem and the statements about vanishing
minors, which depend only on the support, are not concerned. Section~\ref{sec:tvar}
gives a numerical test of what happens outside $\F_p$.
\end{remark}

\subsection*{The kernel of a block is the image of a first-order differential operator}

For $f=1+\sigma x^r+x^d$ and $N\ge1$, put $L_Nq=f\,q'+(N+1)f'\,q$; we have
$L_Nq=(qf^{N+1})'/f^N$.

\begin{theorem}[\textbf{[D]}]
\label{thm:ker}
Let $f$ be squarefree in $\F_p[x]$ and $N<p$. A polynomial $h$ satisfies
$C(f^Nh\,dx)=0$ if and only if there is $q\in\F_p[x]$ with $h=L_Nq$. The kernel of
the block $M$ (window $\deg h<g$) is therefore $\{L_Nq:\deg L_Nq<g\}$.
\end{theorem}
\begin{proof}
($\Leftarrow$) $f^Nh=(qf^{N+1})'$ is exact, so $C(f^Nh\,dx)=0$.

($\Rightarrow$) A polynomial form is killed by $C$ if and only if it has no
monomial $x^{pk-1}$, i.e.\ if and only if it is exact: $f^Nh=g'$ with
$g\in\F_p[x]$ (defined modulo $\F_p[x^p]$). At each root $\rho$ of $f$ (a simple
root), write $g=\sum_m c_m(x-\rho)^m$; since $f^N\mid g'$, we have $m\,c_m=0$ for
$1\le m\le N$, and $m$ is invertible in $\F_p$ because $N<p$. Hence
$g\equiv g(\rho)\pmod{(x-\rho)^{N+1}}$.

Let $A=\F_p[x]/(f)$, an \'etale algebra; the Frobenius $a\mapsto a^p$ of $A$ is
bijective. Let $w_0\in\F_p[t]$ be such that the class of $w_0(\bar x)$ is
$\mathrm{Fr}^{-1}(\bar g)$, and put $w=w_0$. Then $w(x^p)=w_0(x)^p\equiv g\pmod f$,
so $w(\rho^p)=g(\rho)$ for every root. Now $x^p-\rho^p=(x-\rho)^p$, so
$w(x^p)\equiv w(\rho^p)=g(\rho)\pmod{(x-\rho)^{p}}$, in particular modulo
$(x-\rho)^{N+1}$ (since $N+1\le p$). Thus $g-w(x^p)$ is divisible by
$(x-\rho)^{N+1}$ for each root, hence by $f^{N+1}$ ($f$ monic with distinct
roots): $g=w(x^p)+qf^{N+1}$. As $w(x^p)'=0$, we get
$f^Nh=g'=f^N(fq'+(N+1)f'q)$, i.e.\ $h=L_Nq$.
\end{proof}

\noindent\textbf{[V]} On $223$ smooth cases where $M_0$ is deficient
($p\le13$, $d\le15$, $g_0\le8$), the dimension of the kernel coincides with that
of $\{L_Nq:\deg L_Nq<g_0\}$; it suffices to take $\deg q<d(p-1-N)$ (this is the bound of the companion note:
$L_N$ coincides with $L(G)=fG'-jf'G$, $j=p-1-N$, whose window is $\deg G\le dj$,
for windows $g\le d$); a smaller bound would wrongly give a
smaller kernel (we first made this truncation error). \textbf{[V]} The bound was
tested on $2000$ random cases with $0$ mismatches (\texttt{verify\_kernel\_theorem.py}).

\subsection*{A recurrence and the twin columns}

\begin{lemma}[\textbf{[D]}, recurrence]
\label{lem:rec}
Let $f^N=\sum a_ex^e$. For every $e\in\mathbb Z$:
$e\,a_e+\sigma\,(e-(N+1)r)\,a_{e-r}+(e-(N+1)d)\,a_{e-d}=0.$
\end{lemma}
\begin{proof}
Compare the coefficients of $x^{e-1}$ in $f\,(f^N)'=N\,f'f^N$: on the left
$e\,a_e+\sigma(e-r)a_{e-r}+(e-d)a_{e-d}$, on the right
$N\sigma r\,a_{e-r}+Nd\,a_{e-d}$.
\end{proof}

Write $c_m[b]=a_{pb-m}$ (column $m$, $m\in\mathbb Z$). With $e=pb-i$ we have
$e\equiv-i\pmod p$, whence a relation \emph{with constant coefficients} between
columns:
$$-i\,c_i-\sigma\,(i+(N+1)r)\,c_{i+r}-(i+(N+1)d)\,c_{i+d}\equiv0\pmod p .$$

\begin{corollary}[\textbf{[D]}, twin columns]
\label{cor:jum}
If $i\equiv-(N+1)d\pmod p$, $1\le i$, $i+r\le g_0$ and $i\not\equiv0\pmod p$, then
$c_i=-\sigma\,\dfrac{i+(N+1)r}{i}\,c_{i+r}$ in $M_0$ modulo $p$. Hence
$\operatorname{rk}M_0<g_0$ and $\det\Phi\equiv0\pmod p$ for every $\sigma$.
\end{corollary}

\noindent\emph{Examples.} (a) $(d,r,p,k)=(4,1,7,2)$, $n=3$ (cycle of length $1$,
$N=4$, $g=2$): $f=1+\sigma x+x^4$, $f^4$ gives
$M=\begin{pmatrix}12\sigma^2&12\sigma\\4\sigma&4\end{pmatrix}$ (coefficients
$12=4!/(1!\,2!\,1!)$ at $x^6$, $12$ at $x^5$, $4=4!/(0!\,1!\,3!)$ at $x^{13}$,
$4=4!/(1!\,0!\,3!)$ at $x^{12}$), column~$1=\sigma\cdot$ column~$2$ and
$\det M=48\sigma^2-48\sigma^2=0$ exactly in $\mathbb Z[\sigma]$; the corollary
predicts it: $i\equiv-5\cdot4=-20\equiv1\pmod7$.
(b) $(n,p,d,r,k_0)=(8,19,11,3,5)$: $N=16$, $i\equiv-17\cdot11\equiv3$, partner
$i+r=6$, and $-(3+17\cdot3)/3\equiv1$, so $c_3=\sigma c_6$: the equality is even
exact in $\mathbb Z[\sigma]$ (the terms $(u,v,w)=(m,m{+}1,15{-}2m)$ of column $3$
and $(m{+}1,m,15{-}2m)$ of column $6$ have the same multinomial coefficient).
The corollary thus explains five of the seven single-twin-column cases of $M_0$ in
the census below: $(8,11,13,4,5)$, $(8,11,17,1,5)$, $(12,17,19,4,7)$,
$(8,19,11,3,5)$, $(12,31,17,3,5)$. The two other twins $(8,11,19,14,5)$ (columns
$3,8$, shift $d-r$) and $(8,29,15,1,3)$ (columns $1,3$, ratio $\sigma^2$) come
from other relations of the same family or from a composition; we have not proved
them.

\subsection*{The module of exact forms: observed laws}

$L_N$ is $\F_p[t]$-linear for $t=x^p$, so $\operatorname{Im}L_N$ is a submodule of
$\F_p[x]=\bigoplus_{s=0}^{p-1}\F_p[t]x^s$. Let $\Lambda_N$ be the set of leading
degrees of its non-zero elements; the dimension of the kernel of the block of
window $g$ is $\#\{\ell\in\Lambda_N:\ell<g\}$ (Th.~\ref{thm:ker}).
\begin{itemize}
\item \textbf{[D]} No element of $\operatorname{Im}L_N$ has leading degree
$\equiv-1-Nd\pmod p$: the leading term of $f^Nh=g'$ has degree $\deg h+Nd$, and a
derivative has no monomial $x^{pk-1}$.
\item \textbf{[V]} Over $108\,736$ situations ($p\le17$, $d\le21$, all $r$, all
$N<p$, $\sigma$ such that $f$ is squarefree): the module has rank $p-1$; if
$\nu_s=s+pk_s$ is the smallest leading degree of class $s$, then
$\sum_sk_s=\lfloor Nd/p\rfloor$ (conservation law, not proved); the profile
$(\nu_s)$ is independent of $\sigma$ in $9731$ of the $10\,302$ combinations
$(p,d,r,N)$ having at least two smooth $\sigma$ ($94.5\,\%$) and depends on
$\sigma$ in $571$.
\item \textbf{[V]} For the binomial ($\sigma=0$, $c=(N+1)d\not\equiv0$): the
profile has as missing leading degrees the class $-1-Nd$ and the starting
vertices $v_0<d-1$ such that $(-1-v_0)d^{-1}\bmod p<(-1-c-v_0)d^{-1}\bmod p$
(checked on $1307$ cases out of $1307$). Example $(p,d,N)=(7,4,4)$: class $4$ and
starts $1,2$.
\item \textbf{[V]} For the trinomial, the simple rule ``first cancellation of a
coefficient'' (first leading degree $=a_0+r-1$ or $a_0-1$ with
$a_0=-(N+1)d\bmod p$) holds in only $20\,\%$ of cases: no closed formula
(\textbf{[O]}).
\end{itemize}

\subsection*{The rank cut}

\begin{proposition}[\textbf{[D]}, Menger with true ranks]
\label{prop:cut}
For every partition $\{1,\dots,g_1\}=S\sqcup S^c$:
$\operatorname{rk}\Phi\le\operatorname{rk}M_1[\,:,S]+\operatorname{rk}M_0[S^c,:\,]$.
More generally, for every invertible diagonal matrix $D$ of size $g_1$,
$\operatorname{rk}(M_1DM_0)\le\operatorname{rk}M_1[\,:,S]+\operatorname{rk}M_0[S^c,:\,]$.
\end{proposition}
\begin{proof}
$M_1DM_0=M_1[:,S]D_SM_0[S,:]+M_1[:,S^c]D_{S^c}M_0[S^c,:]$; the first term has rank
$\le\operatorname{rk}M_1[:,S]$, the second rank $\le\operatorname{rk}M_0[S^c,:]$,
and rank is subadditive.
\end{proof}
Menger's theorem is the same bound with the rank replaced by the maximum matching
of the support. This inequality is elementary and probably classical; we claim no
novelty. The version with $D$ is used in \S\ref{sec:tvar}.

\medskip\noindent\textbf{Census [V].} Domain: $p\le31$, $3\le n\le12$,
$p^2\equiv1\pmod n$, $p\not\equiv1\pmod n$, $d\le25$, $\gcd(d,n)=1$, all $r$,
$2\le g_0\le12$, pairs $(k_0,k_1)$ with $k_1>k_0$. We keep the cases where
$\det\Phi\equiv0$ \emph{identically in $\mathbb Z[\sigma]$} (test at a random
$\sigma$ modulo $2^{61}-1$), with a perfect matching in the support of $\Phi$:
$33$ cases, i.e.\ $27$ distinct cases once the cases $(n,k_0)\sim(n',k_0')$ with
the same $k_0/n$ are identified (our earlier sweeps did not make this
