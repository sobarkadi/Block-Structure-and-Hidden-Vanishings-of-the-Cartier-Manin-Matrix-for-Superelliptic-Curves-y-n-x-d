\section{Catalogue of hidden vanishings and the corank pattern}

\begin{definition}[Hidden vanishing, general case $y^n$]
For a cycle $(i_0,i_1,\dots,i_{L-1})$ of the permutation $\sigma(i)=i\cdot
p^{-1}\bmod n$, let $\Phi_{i_0}(\sigma)=M^{(i_{L-1})}\cdots M^{(i_1)}M^{(i_0)}$
be the composed return map (square, $g_{i_0}\times g_{i_0}$, where $g_{i_0}$ is
the dimension of the starting block). We say that $(n,p,d,r)$ exhibits a
\textbf{hidden vanishing} at the cycle of $i_0$ if (a) the bipartite support
graph of $\Phi_{i_0}$ admits a perfect matching ($\nu(G)=g_{i_0}$) and (b)
$\mathrm{rk}\big(\Phi_{i_0}(\sigma)\big)<g_{i_0}$ for \textbf{every}
$\sigma\in\mathbb F_p$ (tested exhaustively, $f$ squarefree).
\end{definition}

\begin{remark}[Terminology: Fermat-type cases]
In a ``Fermat-type'' case $\det\Phi\not\equiv0$ as a polynomial in $\sigma$, but
$\det\Phi$ vanishes at every $\sigma\in\F_p^\times$ (it is divisible by
$\sigma^{p-1}-1$). These cases satisfy the Definition (b) only because
$\sigma$ is restricted to $\F_p$; they are degenerate exactly at
$\sigma^{p-1}=1$, so they are \emph{not} hidden vanishings in the formal sense
($\det\Phi\equiv0$), and we keep a distinct name for them. A hand-checkable instance is
$(n,p,d,r)=(9,17,16,3)$ and $k=2$: with $k_1=7$, $g_0=3$, $g_1=12$, $N_0=13$, $N_1=3$, the
$3\times3$ return map satisfies $\det\Phi\equiv8(\sigma^{16}-1)\pmod{17}$
\textbf{[V]} (symbolic computation, confirmed numerically for all $\sigma\in\F_{17}^\times$).
\end{remark}

\begin{remark}[Combinatorial filter]
Condition (a) is checked in negligible time (maximum bipartite matching,
Kuhn's algorithm) and \textbf{before} any numerical rank computation: by the
Leibniz expansion, $\det\Phi_{i_0}=\sum_\pi
\mathrm{sgn}(\pi)\prod_i(\Phi_{i_0})_{i,\pi(i)}$ contains only terms indexed by
the perfect matchings of the support; if $\nu(G)<g_{i_0}$ no term can be
non-zero and $\det\Phi_{i_0}\equiv0$ \textbf{trivially}, with no algebraic
coincidence at play. This filter thus eliminates, for free, all
non-\emph{hidden} vanishings before the exhaustive sweep of (b), the only costly
step --- which is what makes a sweep over several thousand families $(n,d,r,p)$
practicable.
\end{remark}

\begin{proposition}[Survey result]
A combinatorial sweep (filter (a), then exhaustive sweep of (b) on the
survivors) covering $n=3,\dots,15$, $d=2,\dots,25$ ($\gcd(d,n)=1$), all $r$,
primes $p\in\{3,\dots,47\}$ ($\gcd(p,n)=1$, $g\le20$), produces
\textbf{233 confirmed hidden vanishings}. Three of them were cross-checked
against an independently written implementation (no shared code), with exact
agreement.
\end{proposition}

\begin{remark}[Empirical pattern: corank almost always 1]
Over the 233 cases, the deficit $g_{i_0}-\mathrm{rk}\big(\Phi_{i_0}(\sigma)\big)$
(maximised over $\sigma$) equals $1$ in $201/233$ cases ($86\%$), and this is not
an artefact of small blocks: restricting to the cases $g_{i_0}\ge4$, the deficit
is still $1$ in $175/206$ cases ($85\%$). In other words, when a hidden
vanishing occurs it almost always corresponds to a single missing linear
relation (corank exactly $1$), and not to a deep degeneration --- generalising,
beyond the isolated case $g_{i_0}=2$ (where corank $1$ is trivial), the
outer-product structure observed on the example $(n,d,r,p)=(3,4,1,7)$ (\S4).
The remaining $14\%$ (deficit $2$, and $2$ isolated cases of deficit $3$ and
$4$) remain to be explained; an immediate lead is to check whether an iterated
outer-product structure (corank $k$ via $k$ independent relations) can be seen
directly on the matrices.
\end{remark}

\section{Block theory and corank (results proved by hand)}
\label{sec:blocs}

\emph{Statuses used throughout:} \textbf{[D]} proved (hand proof, written in
the accompanying note \texttt{proofs\_blocks.tex}); \textbf{[V]} checked numerically on a
finite set of cases, not proved; \textbf{[O]} open.

Write $k'=k_{\mathrm{out}}$ and, for the block $M^{(k)}$ (of size
$g_{k'}\times g_k$), $N=N(k)<p$, $j=p-1-N$, $m=\lfloor dj/p\rfloor$. The entries
are $M^{(k)}[b,i]=[x^{pb-i}]f^N$ (Th.~\ref{thm:A}). Since $N<p$, the
multinomial coefficients of $f^N$ are non-zero modulo $p$: the \emph{support} of
$M^{(k)}$ is purely combinatorial. Put $L(G)=fG'-jf'G$.

\begin{theorem}[Kernel of a block, \textbf{[D]}]
\label{thm:noyau}
$\Ker M^{(k)}$ is isomorphic to the space of polynomials $G$ of degree
$\le dj$ such that $\deg L(G)\le g-1$ (explicit isomorphism, see
\texttt{proofs\_blocks.tex}, Th.~2). There is a basis $(h_M)$ of the corresponding
subspace (Prop.~6) and
$$\operatorname{corank}M^{(k)}=m-\operatorname{rk}A,\qquad
A_{M,e}=[x^e]\,L(P_M),\quad e\in[g,d-2]\quad(\text{Th.~7}).$$
\end{theorem}

\begin{theorem}[Duality law (K), \textbf{[D]}]
\label{thm:K}
The corank $\kappa_k$ of the block $M^{(k)}$ (Th.~\ref{thm:noyau}) satisfies
$\kappa_k=\dim\operatorname{coker}M^{(n-k)}$ (law (K), Th.~10 of the accompanying
note), and
$$\operatorname{rk}M^{(k)}-\operatorname{rk}M^{(n-k)}=g_k+g_{k'}-(d-1)\quad(\text{Cor.~11}).$$
In particular, for a self-dual $2$-cycle $k_1=n-k_0$, the two blocks have the
same rank.
\end{theorem}

\begin{remark}[Antecedents]
The block formula of Th.~\ref{thm:A} already appears in Hase-Liu and
Triantafillou (arXiv:1709.02442); see also Sutherland (arXiv:2004.10189), Elkin,
Johnston. We do not present it as new. The statements of
Th.~\ref{thm:noyau}--\ref{thm:K} (description of the kernel by the differential
equation $L(G)$ and the duality law) were not found in any of the sources
consulted, but no zbMATH/MathSciNet-type database could be queried:
\textbf{no claim of novelty}.
\end{remark}

\subsection*{Cycles of length 2: decomposition formula}

For a $2$-cycle $(k_0,k_1)$ put $M_0=M^{(k_0)}$, $M_1=M^{(k_1)}$ and
$\Phi=M_1M_0$ ($g_0\times g_0$). Then \textbf{[D]}
$$\dim\Ker\Phi=\dim\Ker M_0+\dim(\operatorname{Im}M_0\cap\Ker M_1),$$
and the intersection is the radical of a bilinear form
$-\mathrm{Res}_0\big(G_1(f\nu'+(j_1+1)f'\nu)\,dx\big)$ on $W_{k_1}\times N_0$
(the two factors live in different spaces: no isotropy test is available).

\subsection*{The case $d=p$}

For $d=p$ and a $2$-cycle ($N_0=g_1$, $N_1=g_0$), put
$\beta(j)\equiv -j\,r^{-1}\pmod p$ and $t(j)=(j+r\beta(j))/p$.

\begin{lemma}[Lemmas A and B, \textbf{[D]}]
\label{lem:AB}
(A) $\Phi=\sum_b K_1[a,b]\,\sigma^{\beta(b)}K_0[b,i]\,\sigma^{\beta(i)}$: each
entry of $\Phi$ factors in two stages, where $K_0,K_1$ are numerical matrices
(multinomials) and $\sigma^{\beta}$ powers of the parameter. (B) The supports of
$K_0,K_1$ are explicit \emph{windows} (bands) in $(b,\beta(b))$.
\end{lemma}

An index $b$ is called \emph{active} if $\beta(b)\in[1,g_0]$ and the
corresponding row of $K_0$ and column of $K_1$ are non-zero.

\begin{proposition}[Active-count criterion, \textbf{[D]}]
$\operatorname{rk}\Phi\le\#\{\text{active}\}$; $K_1[\cdot,\mathrm{act}]$ always
has full rank, so $\Phi$ is degenerate \emph{if and only if}
$K_0[\mathrm{act},\cdot]$ is singular. In the $133/135$ cases studied, the
singularity is expressed by a Hall violation visible on a prefix of columns
ordered by decreasing $\beta$ (violation sizes: $1{:}93$, $2{:}32$, $3{:}4$,
$4{:}2$, $6{:}1$, $10{:}1$).
\end{proposition}

For general $d$, \textbf{[D, case by case]}:
$\operatorname{rk}\Phi\le\min(\nu(S_0),\nu(S_1),\#\text{active})$, where
$S_0,S_1$ are the combinatorial supports and $\nu$ the maximum matching; this
criterion explains $39$ of the $143$ cases of the catalogue.

\subsection*{Cases studied by hand \textbf{[D]}}
For the following families $(n,p,d,r,k_0,k_1)$ the degeneracy is proved by hand:
$(6,17,17,10,1,5)$, $(5,19,19,6,1,4)$, $(9,17,7,2,4,5)$, $(9,17,10,3,4,5)$ (rank
$M_0\le3$, kernel $(5\sigma^6,0,1,8\sigma^7)$, $\operatorname{coker}\simeq M_1$),
$(5,29,18,6,2,3)$, and $(9,17,16,3,2,7)$ with $\det\Phi=8(\sigma^{16}-1)$.

